      },
      {
        "command": "gitHistory.focusSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.showKeyboardHelp",
        "key": "shift+/",
        "mac": "shift+/",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.cycleDiffContextLines",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.cycleSortMode",
        "key": "ctrl+shift+3",
        "mac": "cmd+shift+3",
        "when": "activeWebviewPanelId == gitHistory.webview"
      }
    ],
    "configuration": {
      "title": "Git History",
      "properties": {
        "gitHistory.maxCommits": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of commits to display"
        },
        "gitHistory.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show commit graph visualization in the history view"
        },
        "gitHistory.blame.dateFormat": {
          "type": "string",
          "default": "relative",
          "enum": [
            "relative",
            "short",
            "iso"
          ],
          "description": "Date format for blame annotations"
        },
        "gitHistory.hideMergeCommits": {
          "type": "boolean",
          "default": false,
          "description": "Hide merge commits in the history view"
        },
        "gitHistory.defaultDiffView": {
          "type": "string",
          "default": "unified",
          "enum": [
            "unified",
            "side-by-side"
          ],
          "description": "Default diff view mode when opening Git History"
        },
        "gitHistory.diffContextLines": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of context lines to show in diffs (1-10)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production && npm run compile-tests",
    "compile-tests": "tsc -p test/tsconfig.json",
    "watch": "webpack --mode development --watch",
    "test": "node ./out/test/runTest.js",
    "screenshot": "npm run compile-tests && node ./out/test/runScreenshot.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.5",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "copy-webpack-plugin": "^12.0.2",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "diff2html": "^3.4.47"
  }
}
