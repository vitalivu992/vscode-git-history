    "configuration": {
      "title": "Git History",
      "properties": {
        "gitHistory.maxCommits": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of commits to display"
        },
        "gitHistory.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show commit graph visualization in the history view"
        },
        "gitHistory.blame.dateFormat": {
          "type": "string",
          "default": "relative",
          "enum": [
            "relative",
            "short",
            "iso"
          ],
          "description": "Date format for blame annotations"
        },
        "gitHistory.hideMergeCommits": {
          "type": "boolean",
          "default": false,
          "description": "Hide merge commits in the history view"
        },
        "gitHistory.defaultDiffView": {
          "type": "string",
          "default": "unified",
          "enum": [
            "unified",
            "side-by-side"
          ],
          "description": "Default diff view mode when opening Git History"
        },
        "gitHistory.diffContextLines": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of context lines to show in diffs (1-10)"
        },
        "gitHistory.showSignatures": {
          "type": "boolean",
          "default": true,
          "description": "Show GPG signature verification status for signed commits"
        }
      }
    }
