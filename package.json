      {
        "command": "gitHistory.copyTags",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyAuthorEmail",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyAuthorName",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyParentHash",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyShortHash",
        "key": "ctrl+shift+7",
        "mac": "cmd+shift+7",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copySubject",
        "key": "ctrl+shift+6",
        "mac": "cmd+shift+6",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyDiffStatSummary",
        "key": "ctrl+shift+9",
        "mac": "cmd+shift+9",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyCoAuthors",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyCommitDate",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyRelativeDate",
        "key": "ctrl+shift+8",
        "mac": "cmd+shift+8",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyOneline",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyCommitBody",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copySelectedHashes",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyFileName",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyFilterQuery",
        "key": "ctrl+shift+5",
        "mac": "cmd+shift+5",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.pasteFilterQuery",
        "key": "ctrl+shift+4",
        "mac": "cmd+shift+4",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.copyFilePath",
        "key": "ctrl+shift+\\.",
        "mac": "cmd+shift+.",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.exportCommits",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == gitHistory.webview"
      },
      {
        "command": "gitHistory.quickCompare",
