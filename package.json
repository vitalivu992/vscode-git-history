    "menus": {
      "editor/context": [
        {
          "command": "gitHistory.showFileHistory",
          "group": "git",
          "when": "editorHasSelection"
        },
        {
          "command": "gitHistory.showFileHistory",
          "group": "git",
          "when": "!editorHasSelection"
        },
        {
          "command": "gitHistory.showSelectionHistory",
          "group": "git",
          "when": "editorHasSelection"
        },
        {
          "command": "gitHistory.toggleBlame",
          "group": "git",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
